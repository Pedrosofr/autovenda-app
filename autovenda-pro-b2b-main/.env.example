# =============================================
# ROZZ CAR - Variaveis de Ambiente
# =============================================
# Copie este arquivo para .env e preencha seus dados.
# NUNCA commite o .env com valores reais.

# Chave da API Google Gemini (obtenha em https://aistudio.google.com/apikey)
GOOGLE_API_KEY=cole_sua_chave_gemini_aqui

# Banco de dados SQLite (caminho relativo ao projeto)
DATABASE_PATH=./data/rozzcar.sqlite

# Banco de dados Postgres/Supabase
# Quando DATABASE_URL estiver preenchida, o backend prioriza Postgres.
# No Supabase, prefira:
# DATABASE_URL = Session Pooler
# DIRECT_URL = Direct connection
DATABASE_URL=
DIRECT_URL=

# Opcional: caminho do SQLite antigo para migracao ao Postgres
SQLITE_MIGRATION_PATH=

# Segredo para assinar cookies de sessao
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque_por_um_segredo_longo_e_unico

# Opcional (recomendado): chave dedicada para criptografar focusApiKey da NF-e em repouso.
# Se vazio, o sistema deriva a chave a partir de SESSION_SECRET.
NFE_CONFIG_ENCRYPTION_KEY=

# Admin da plataforma (voce que controla todas as lojas)
PLATFORM_ADMIN_EMAIL=seu_email_admin@exemplo.com
PLATFORM_ADMIN_PASSWORD=crie_uma_senha_forte_para_o_admin

# Dias de trial padrao para novas lojas
DEFAULT_TRIAL_DAYS=7

# URL base da aplicacao (use https:// em producao!)
APP_BASE_URL=http://localhost:8082

# Resend - envio de emails de recuperacao de senha (obtenha em https://resend.com/api-keys)
RESEND_API_KEY=cole_sua_chave_resend_aqui
EMAIL_FROM=noreply@seudominio.com
